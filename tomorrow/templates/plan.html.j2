<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ plan_date_label }}</title>
  <script>
    try {
      const savedTheme = localStorage.getItem("tomorrow-theme");
      if (savedTheme === "light" || savedTheme === "dark") {
        document.documentElement.dataset.theme = savedTheme;
      }
    } catch (_) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,400;0,500;1,400&family=Instrument+Serif:ital@0;1&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      color-scheme: dark;
      --bg: #1a1714;
      --rail: #948877;
      --ink: #ece4d8;
      --anchor: #7fae8a;
      --anchor-bg: #213027;
      --flex: #b8987f;
      --flex-bg: #2a241f;
      --prep-bg: #221e1a;
      --prep-border: #3a332c;
      --gap-line: rgba(255,255,255,0.14);
      --bundle-divider: #2e2823;
    }
    :root[data-theme="light"] {
      color-scheme: light;
      --bg: #f7f3ed;
      --rail: #c4b5a0;
      --ink: #2c2419;
      --anchor: #3d5a45;
      --anchor-bg: #e8f0ea;
      --flex: #6b5344;
      --flex-bg: #f0ebe4;
      --prep-bg: #fff;
      --prep-border: #ddd5c8;
      --gap-line: rgba(0,0,0,0.12);
      --bundle-divider: #f0ebe4;
    }
    html { background: var(--bg); }

    .plan-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      align-items: baseline;
    }
    .plan-date { font-weight: 600; }
    .plan-bounds, .plan-weather { opacity: 0.72; font-size: 0.92em; }

    .checklist { list-style: none; }
    .checklist li {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 0.35rem 0;
      font-size: 0.92em;
    }
    .checklist input[type="checkbox"] {
      margin-top: 0.12rem;
      width: 1.05rem;
      height: 1.05rem;
      accent-color: var(--anchor);
      flex-shrink: 0;
    }
    .checklist label { cursor: pointer; }
    .checklist input:checked + label { text-decoration: line-through; opacity: 0.5; }
    .todo-note {
      white-space: pre-line;
      font-size: 0.85em;
      opacity: 0.6;
      margin-top: 0.15rem;
      text-decoration: none !important;
    }

    .v-tl-base {
      background: var(--bg);
      color: var(--ink);
      font-family: "Outfit", system-ui, sans-serif;
      min-height: 100dvh;
    }
    .v-tl-base .shell {
      max-width: 32rem;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 2.5rem;
    }
    @media (min-width: 768px) {
      .v-tl-base .shell { max-width: 36rem; padding: 2rem 1.5rem 3rem; }
    }
    .v-tl-base .plan-header {
      position: relative;
      margin-bottom: 1.75rem;
      padding-right: 2.5rem;
      font-size: 0.95rem;
    }
    .v-tl-base .theme-toggle {
      position: absolute;
      top: 0;
      right: 0;
      width: 2rem;
      height: 2rem;
      border: 1px solid var(--prep-border);
      border-radius: 999px;
      background: var(--prep-bg);
      color: var(--ink);
      font-size: 0.95rem;
      line-height: 1;
      cursor: pointer;
    }
    .v-tl-base .theme-toggle:focus-visible { outline: 2px solid var(--anchor); outline-offset: 2px; }
    .v-tl-base .plan-date {
      font-family: "Instrument Serif", Georgia, serif;
      font-size: 1.65rem;
      font-weight: 400;
      width: 100%;
    }
    .v-tl-base .rail-wrap {
      position: relative;
      padding-left: 3.25rem;
      margin-bottom: 2rem;
    }
    .v-tl-base .rail-wrap::before {
      content: "";
      position: absolute;
      left: 1.1rem;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(var(--rail), transparent 98%);
    }
    .v-tl-base .block {
      position: relative;
      margin-bottom: 0.35rem;
      border-radius: 8px;
      padding: 0.65rem 0.85rem;
      border-left: 3px solid transparent;
    }
    .v-tl-base .block.anchor {
      background: var(--anchor-bg);
      border-left-color: var(--anchor);
    }
    .v-tl-base .block.flex {
      background: var(--flex-bg);
      border-left-color: var(--flex);
      border-left-style: dashed;
    }
    .v-tl-base .block.gap-filler {
      background: transparent;
      border: none;
      border-left: 1px dashed var(--gap-line);
      font-size: 0.68rem;
      padding: 0.25rem 0.85rem;
      color: var(--rail);
      display: flex;
      align-items: center;
      min-height: unset !important;
    }
    .v-tl-base .time-tag {
      position: absolute;
      left: -3.25rem;
      width: 2.75rem;
      text-align: right;
      font-family: "DM Mono", monospace;
      font-size: 0.72rem;
      color: var(--rail);
      top: 0.7rem;
    }
    .v-tl-base .block-title { font-weight: 600; font-size: 0.95rem; }
    .v-tl-base .block-range {
      font-family: "DM Mono", monospace;
      font-size: 0.72rem;
      opacity: 0.55;
      margin-top: 0.15rem;
    }
    .v-tl-base .bounds-cap {
      font-family: "DM Mono", monospace;
      font-size: 0.72rem;
      color: var(--rail);
      padding: 0.5rem 0;
      text-align: center;
    }
    .v-tl-base .prep-section {
      border-top: 2px solid var(--prep-border);
      padding-top: 1.25rem;
    }
    .v-tl-base .prep-heading {
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--rail);
      margin-bottom: 0.85rem;
    }
    .v-tl-base .prep-done {
      margin-top: 1rem;
      border-top: 1px dashed var(--prep-border);
      padding-top: 0.75rem;
    }
    .v-tl-base .prep-done summary {
      font-size: 0.75rem;
      color: var(--rail);
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .v-tl-base .prep-done summary::-webkit-details-marker { display: none; }
    .v-tl-base .prep-done summary::before { content: "▸"; font-size: 0.65rem; }
    .v-tl-base .prep-done[open] summary::before { content: "▾"; }
    .v-tl-base .done-list { margin-top: 0.65rem; opacity: 0.55; }

    .v-tl-accordion .prep-bundle {
      background: var(--prep-bg);
      border: 1px solid var(--prep-border);
      border-radius: 10px;
      margin-bottom: 0.5rem;
      overflow: hidden;
    }
    .v-tl-accordion .prep-bundle summary {
      padding: 0.85rem 1rem;
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
      font-size: 0.92rem;
    }
    .v-tl-accordion .prep-bundle summary::-webkit-details-marker { display: none; }
    .v-tl-accordion .prep-bundle summary::after {
      content: "+";
      font-family: "DM Mono", monospace;
      font-size: 0.85rem;
      color: var(--rail);
      font-weight: 400;
    }
    .v-tl-accordion .prep-bundle[open] summary::after { content: "−"; }
    .v-tl-accordion .prep-bundle .checklist {
      padding: 0 1rem 0.85rem;
      border-top: 1px solid var(--bundle-divider);
    }
    .v-tl-accordion .bundle-sub {
      font-weight: 400;
      font-size: 0.78rem;
      color: var(--rail);
      margin-left: 0.35rem;
    }
    .v-tl-accordion .bundle-count {
      font-family: "DM Mono", monospace;
      font-size: 0.68rem;
      font-weight: 400;
      color: var(--rail);
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; animation: none !important; }
    }
  </style>
</head>
<body>
  <div class="v-tl-base v-tl-accordion">
    <div class="shell">
      <header class="plan-header">
        <button type="button" id="theme-toggle" class="theme-toggle"></button>
        <div class="plan-meta">
          <div class="plan-date">{{ plan_date_label }}</div>
          <div class="plan-bounds">Wake {{ wake }} · Sleep {{ sleep }}</div>
          {% if weather %}
          <div class="plan-weather">{{ weather }}</div>
          {% endif %}
        </div>
      </header>
      <div class="bounds-cap">↑ {{ wake }} wake</div>
      <div class="rail-wrap">
        {% for entry in timeline %}
        {% if entry.kind == "gap" %}
        <div class="block gap-filler" style="min-height:{{ entry.min_height_px }}px">{{ entry.label }}</div>
        {% else %}
        <div class="block {{ entry.kind }}" style="min-height:{{ entry.min_height_px }}px">
          <div class="time-tag">{{ entry.start_label }}</div>
          <div class="block-title">{{ entry.name }}</div>
          <div class="block-range">{{ entry.start_label }}–{{ entry.end_label }}</div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
      <div class="bounds-cap">{{ sleep }} sleep ↓</div>
      <section class="prep-section" aria-label="Pack and prep">
        <div class="prep-heading">Pack &amp; prep</div>
        <div id="prep-active"></div>
        <div id="prep-done"></div>
      </section>
      {% if todos %}
      <section class="prep-section todos-section" aria-label="To-dos">
        <div class="prep-heading">To-dos</div>
        <ul class="checklist" id="todos-list">
          {% for todo in todos %}
          <li>
            <input type="checkbox" id="todo-{{ todo.slug }}" data-todo="{{ todo.slug }}">
            <label for="todo-{{ todo.slug }}">
              <div>{{ todo.name }}</div>
              {% if todo.note %}
              <div class="todo-note">{{ todo.note }}</div>
              {% endif %}
            </label>
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
    </div>
  </div>
  <script>
    const THEME_STORAGE_KEY = "tomorrow-theme";
    const themeToggle = document.getElementById("theme-toggle");

    function nextTheme() {
      return document.documentElement.dataset.theme === "light" ? "dark" : "light";
    }

    function renderThemeToggle() {
      const next = nextTheme();
      themeToggle.textContent = next === "light" ? "☀" : "☾";
      themeToggle.setAttribute("aria-label", `Switch to ${next} theme`);
      themeToggle.title = `Switch to ${next} theme`;
    }

    themeToggle.addEventListener("click", () => {
      const next = nextTheme();
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem(THEME_STORAGE_KEY, next); } catch (_) {}
      renderThemeToggle();
    });

    renderThemeToggle();

    const PLAN = {
      dateKey: {{ plan_date_key|tojson }},
      bundles: [
        {% for bundle in prep_bundles %}
        {
          itemId: {{ bundle.item_id|tojson }},
          itemName: {{ bundle.item_name|tojson }},
          checklistId: {{ bundle.checklist_id|tojson }},
          checklistName: {{ bundle.checklist_name|tojson }},
          rows: [
            {% for row in bundle.rows %}
            {{ row.label|tojson }}{% if not loop.last %},{% endif %}
            {% endfor %}
          ]
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    };

    const STORAGE_PREFIX = "tomorrow-plan-" + PLAN.dateKey + "-";

    function storageKey(itemId, rowIndex) {
      return STORAGE_PREFIX + itemId + "-" + rowIndex;
    }

    function isChecked(itemId, rowIndex) {
      return localStorage.getItem(storageKey(itemId, rowIndex)) === "1";
    }

    function setChecked(itemId, rowIndex, checked) {
      const key = storageKey(itemId, rowIndex);
      if (checked) localStorage.setItem(key, "1");
      else localStorage.removeItem(key);
    }

    function bundleProgress(bundle) {
      let done = 0;
      bundle.rows.forEach((_, index) => {
        if (isChecked(bundle.itemId, index)) done++;
      });
      return { done, total: bundle.rows.length, complete: done === bundle.rows.length };
    }

    function bundleLabel(bundle) {
      if (!bundle.checklistName) return bundle.itemName;
      return `${bundle.itemName}<span class="bundle-sub">· ${bundle.checklistName}</span>`;
    }

    function checklistRowsHtml(bundle, prefix) {
      const rows = bundle.rows.map((label, index) => {
        const inputId = prefix + bundle.itemId + "-" + index;
        const checked = isChecked(bundle.itemId, index) ? " checked" : "";
        return `<li><input type="checkbox" id="${inputId}" data-item="${bundle.itemId}" data-cl="${bundle.checklistId}" data-idx="${index}"${checked}><label for="${inputId}">${label}</label></li>`;
      }).join("");
      return `<ul class="checklist" data-bundle="${bundle.itemId}">${rows}</ul>`;
    }

    function splitActiveDone(bundles) {
      const active = [];
      const done = [];
      bundles.forEach(bundle => {
        if (bundleProgress(bundle).complete) done.push(bundle);
        else active.push(bundle);
      });
      return { active, done };
    }

    function renderPrep() {
      const activeRoot = document.getElementById("prep-active");
      const doneRoot = document.getElementById("prep-done");
      const { active, done } = splitActiveDone(PLAN.bundles);

      activeRoot.innerHTML = active.map(bundle => {
        const progress = bundleProgress(bundle);
        return `
          <details class="prep-bundle" data-bundle="${bundle.itemId}">
            <summary>
              <span>${bundleLabel(bundle)}</span>
              <span class="bundle-count">${progress.done}/${progress.total}</span>
            </summary>
            ${checklistRowsHtml(bundle, "acc-")}
          </details>`;
      }).join("");

      doneRoot.innerHTML = done.length ? `
        <details class="prep-done">
          <summary>Done · ${done.length}</summary>
          <div class="done-list">
            ${done.map(bundle => `
              <details class="prep-bundle" open>
                <summary><span>${bundleLabel(bundle)}</span><span class="bundle-count">✓</span></summary>
                ${checklistRowsHtml(bundle, "acc-done-")}
              </details>`).join("")}
          </div>
        </details>` : "";

      document.querySelectorAll(".v-tl-accordion .prep-bundle").forEach(el => {
        el.addEventListener("toggle", () => {
          if (!el.open) return;
          document.querySelectorAll(".v-tl-accordion .prep-bundle").forEach(other => {
            if (other !== el) other.open = false;
          });
        });
      });

      document.querySelectorAll('.checklist input[type="checkbox"]').forEach(cb => {
        cb.addEventListener("change", () => {
          setChecked(cb.dataset.item, Number(cb.dataset.idx), cb.checked);
          renderPrep();
        });
      });
    }

    renderPrep();

    function todoStorageKey(slug) {
      return STORAGE_PREFIX + "todo-" + slug;
    }

    document.querySelectorAll('#todos-list input[type="checkbox"]').forEach(cb => {
      const slug = cb.dataset.todo;
      cb.checked = localStorage.getItem(todoStorageKey(slug)) === "1";
      cb.addEventListener("change", () => {
        const key = todoStorageKey(slug);
        if (cb.checked) localStorage.setItem(key, "1");
        else localStorage.removeItem(key);
      });
    });
  </script>
</body>
</html>
